# Finance portal - ONE department only (not multi-tenant).

# Postgres for THIS app (its own database, separate from the dues portal), e.g. Neon.
DATABASE_URL="postgresql://user:password@host/finance?sslmode=require"

# Auth.js session secret:  openssl rand -base64 32
AUTH_SECRET=""
# Public URL of this app (no trailing slash).
NEXTAUTH_URL="http://localhost:3001"

# Shown in the UI and used to verify sign-in tokens.
# Must equal FINANCE_DEPARTMENT_CODE in the dues portal (e.g. GESA).
DEPARTMENT_CODE=""
DEPARTMENT_NAME=""

# Dues portal connection.
DUES_PORTAL_URL="http://localhost:3000"
# Must equal FINANCE_API_KEY in the dues portal (this app uses it to pull payments).
DUES_API_KEY=""
# Must equal FINANCE_PUSH_TOKEN in the dues portal. Verifies real-time pushes
# and the sign-in handoff token.
DUES_PUSH_TOKEN=""

# Protects /api/cron/sync-dues (Vercel sends it as "Authorization: Bearer <value>").
CRON_SECRET=""
